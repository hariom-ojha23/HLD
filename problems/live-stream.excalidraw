      "boundElements": null,
      "updated": 1793940182513,
      "link": null,
      "locked": false,
      "text": "RTMP uses TCP because in a compress file,\nif we loose a single packet, it will cause glitch or\nstream freee until next packet arrives",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RTMP uses TCP because in a compress file,\nif we loose a single packet, it will cause glitch or\nstream freee until next packet arrives",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VpDSE6mSsh7LeTxdB926G",
      "type": "text",
      "x": 853.6396381756397,
      "y": 493.98265962817794,
      "width": 233.0564422607422,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b09",
      "roundness": null,
      "seed": 969772510,
      "version": 189,
      "versionNonce": 841284958,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793938424835,
      "link": null,
      "locked": false,
      "text": "Uses manifest file to get \nsegments of videos (ABS).\nTo avoid glitch/freeze in\ncase of network is not stable",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uses manifest file to get \nsegments of videos (ABS).\nTo avoid glitch/freeze in\ncase of network is not stable",
      "autoResize": true,
      "lineHeight": 1.25
    },
