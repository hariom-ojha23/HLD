      "isDeleted": false,
      "boundElements": [],
      "updated": 1793938732631,
      "link": null,
      "locked": false,
      "text": "1. Broadcast live sports/other events\n2. Support million of concurrent viewers\n3. Support mutiple video qualities (240, 480, 720, 1080, etc.)\n4. Handle authentication, subscriptions etc.\n5. User can pause, rewind and watch a match again\n6. Analytics like live viewer count, country, etc.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Broadcast live sports/other events\n2. Support million of concurrent viewers\n3. Support mutiple video qualities (240, 480, 720, 1080, etc.)\n4. Handle authentication, subscriptions etc.\n5. User can pause, rewind and watch a match again\n6. Analytics like live viewer count, country, etc.",
      "autoResize": true,
      "lineHeight": 1.25
    },
