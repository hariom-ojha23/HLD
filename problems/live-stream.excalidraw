      "text": "RTMP is prefered as it uses TCP and guarantee\nof every packet delivery. SRT uses UDP",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RTMP is prefered as it uses TCP and guarantee\nof every packet delivery. SRT uses UDP",
      "autoResize": true,
      "lineHeight": 1.25
    },
