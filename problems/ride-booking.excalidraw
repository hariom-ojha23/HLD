      "link": null,
      "locked": false,
      "text": "Fare estimation\nFind nearby and available drivers\nDriver should be able to accept or reject requests\nAppropriate notifications to both driver and rider\nPayment on completion of ride",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fare estimation\nFind nearby and available drivers\nDriver should be able to accept or reject requests\nAppropriate notifications to both driver and rider\nPayment on completion of ride",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-c4kSOXHkEMguXWQFhSJF",
      "type": "text",
      "x": 158.98074801157986,
      "y": 175.96112218381214,
      "width": 377.9527587890625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 1802659723,
      "version": 980,
      "versionNonce": 830487478,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793445749222,
      "link": null,
      "locked": false,
      "text": "Low Latency to find drivers and fare\nDriver should not get multiple request at a time\nTwo driver should not get assigned to one rider\n    - Strong consistency in matching\nAble to handle high throughput\n    - Location update from every online driver\nHigh scalability\nHigh availability",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Low Latency to find drivers and fare\nDriver should not get multiple request at a time\nTwo driver should not get assigned to one rider\n    - Strong consistency in matching\nAble to handle high throughput\n    - Location update from every online driver\nHigh scalability\nHigh availability",
      "autoResize": true,
      "lineHeight": 1.25
    },
