      "updated": 1790845286669,
      "link": null,
      "locked": false,
      "text": "\n\nNon-Functional Requirements:\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nNon-Functional Requirements:\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5i73ssdL-B7X0s1MuE4Xn",
      "type": "text",
      "x": 290.12939699290183,
      "y": 684.7423648640139,
      "width": 348.6796875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 679791121,
      "version": 304,
      "versionNonce": 1973731281,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790845286669,
      "link": null,
      "locked": false,
      "text": "1. Prevent double booking of a seat\n2. Low latency in search\n3. High availability of system\n4. Strong consistency in booking\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Prevent double booking of a seat\n2. Low latency in search\n3. High availability of system\n4. Strong consistency in booking\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
