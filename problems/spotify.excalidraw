      "boundElements": [],
      "updated": 1793794044419,
      "link": null,
      "locked": false,
      "text": "1. User can search from song, artist, genre etc\n2. User can play song.\n3. User can read lyrics\n4. User can like song\n5. User can add/remove song in playlist",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. User can search from song, artist, genre etc\n2. User can play song.\n3. User can read lyrics\n4. User can like song\n5. User can add/remove song in playlist",
      "autoResize": true,
      "lineHeight": 1.25
    },
