      "isDeleted": false,
      "boundElements": [],
      "updated": 1793794044419,
      "link": null,
      "locked": false,
      "text": "1. Low latency for search and musing playing\n2. High availability\n3. Highly scalable\n4. Storong consistency for like, playlist management\n5. Eventual consistency for music upload",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low latency for search and musing playing\n2. High availability\n3. Highly scalable\n4. Storong consistency for like, playlist management\n5. Eventual consistency for music upload",
