      "seed": 93920538,
      "version": 505,
      "versionNonce": 271070170,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791554234765,
      "link": null,
      "locked": false,
      "text": "1. Create payment\n2. Get payment status\n3. Support multiple payment types\n4. Support multiple payment gateways\n5. Prevent duplicate payment charges\n6. Notification updates to clients\n7. Webhook handling and management",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Create payment\n2. Get payment status\n3. Support multiple payment types\n4. Support multiple payment gateways\n5. Prevent duplicate payment charges\n6. Notification updates to clients\n7. Webhook handling and management",
      "autoResize": true,
      "lineHeight": 1.25
    },
