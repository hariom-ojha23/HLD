      "type": "text",
      "x": 326.2830509950345,
      "y": 628.9674455656042,
      "width": 347.74462890625,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
