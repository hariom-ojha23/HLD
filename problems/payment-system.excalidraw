    {
      "id": "Bocg1xYMyJiesSAZ3sHTN",
      "type": "text",
      "x": 321.5135197450345,
      "y": 394.7486955656042,
      "width": 292.560546875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
