      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low latency for searching and map rendering\n2. High availability\n3. Read heavy for map, route, ETA etc.\n4. Write heavy for Location update, Traffic update etc.",
      "autoResize": true,
      "lineHeight": 1.25
