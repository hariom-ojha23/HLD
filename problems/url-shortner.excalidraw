    {
      "id": "zDD7jPSz3dW4Nx1qcUwhj",
      "type": "text",
      "x": 246.69140625,
      "y": 222.19140625,
      "width": 570.2394409179688,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
