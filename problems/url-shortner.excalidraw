      "link": null,
      "locked": false,
      "text": "3. Core Entities/APIs\n\ni.  POST: UrlShortnerService\n       body: longUrl, customAlias, expiry, userId\n\nii. GET: RedirectService\n\niii. GET: AnalyticService/:shortCode",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Core Entities/APIs\n\ni.  POST: UrlShortnerService\n       body: longUrl, customAlias, expiry, userId\n\nii. GET: RedirectService\n\niii. GET: AnalyticService/:shortCode",
      "autoResize": true,
