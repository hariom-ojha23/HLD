      "seed": 1804599997,
      "version": 402,
      "versionNonce": 1467457075,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790619714391,
      "link": null,
      "locked": false,
      "text": "\n1. Functional Requirement\n\n i.  Map long url to short url\n ii. Redirect to original url\n iv. Custom alias\n v. Track analytics like country, browser, device (optional) ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n1. Functional Requirement\n\n i.  Map long url to short url\n ii. Redirect to original url\n iv. Custom alias\n v. Track analytics like country, browser, device (optional) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KleRudExkVIvEhkZ8Fcpl",
      "type": "text",
      "x": 258.28125,
      "y": 442.46875,
      "width": 394.6795654296875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1876721203,
      "version": 353,
      "versionNonce": 518340029,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790616894778,
      "link": null,
      "locked": false,
      "text": "2. Non-functional Requirement\n\ni.   Low latency  - (not slow redirection)\nii.  High availability - (url app is down)\niii.  Strong consistency for URL creation\niv.  Eventual consistency for Analytics\nv.  Read heavy (1000: 1)\nvi.  Short code must be unique",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Non-functional Requirement\n\ni.   Low latency  - (not slow redirection)\nii.  High availability - (url app is down)\niii.  Strong consistency for URL creation\niv.  Eventual consistency for Analytics\nv.  Read heavy (1000: 1)\nvi.  Short code must be unique",
      "autoResize": true,
      "lineHeight": 1.25
    },
