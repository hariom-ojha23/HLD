      "link": null,
      "locked": false,
      "text": "1. User can create & post ads\n2. On clicking on a add, user will be redirected to advertiser website\n3. Advertisers can query click metrics for their ads down to 1 min of granularity",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. User can create & post ads\n2. On clicking on a add, user will be redirected to advertiser website\n3. Advertisers can query click metrics for their ads down to 1 min of granularity",
      "autoResize": true,
      "lineHeight": 1.25
    },
