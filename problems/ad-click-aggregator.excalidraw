      "isDeleted": false,
      "boundElements": [],
      "updated": 1794460241265,
      "link": null,
      "locked": false,
      "text": "Why can't we use CDC or Outbox pattern ?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why can't we use CDC or Outbox pattern ?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZosTmIFD9OifzW7I3R5qo",
      "type": "text",
      "x": 1672.0223826444185,
      "y": 854.5200856896204,
      "width": 547.0092163085938,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 1606540554,
      "version": 238,
      "versionNonce": 2134412054,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794460336239,
      "link": null,
      "locked": false,
      "text": "If we want to use CDC or outbox, we have to store data in DB first\nwhich will be very inefficient as we want to scale to 100k clicks/sec",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If we want to use CDC or outbox, we have to store data in DB first\nwhich will be very inefficient as we want to scale to 100k clicks/sec",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
