    {
      "id": "oiwTzjex6kiIOkSQzidmE",
      "type": "text",
      "x": 1671.016425365412,
      "y": 823.8234954824133,
      "width": 337.95263671875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
