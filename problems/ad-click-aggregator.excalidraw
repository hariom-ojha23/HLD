      "boundElements": [],
      "updated": 1794451679140,
      "link": null,
      "locked": false,
      "text": "1. System should scale from 10K clicks/sec to 100K clicks/sec\n2. Metric queries should response in < 1sec\n3. Metric should be near realtime : ms",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. System should scale from 10K clicks/sec to 100K clicks/sec\n2. Metric queries should response in < 1sec\n3. Metric should be near realtime : ms",
      "autoResize": true,
      "lineHeight": 1.25
    },
