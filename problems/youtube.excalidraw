      "updated": 1791886004573,
      "link": null,
      "locked": false,
      "text": "Functional Requirement:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirement:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y1xt8IXPBh9u4hSi_Ank0",
      "type": "text",
      "x": 132.04737568928783,
      "y": 158.61778881767543,
      "width": 407.0728454589844,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1950962570,
      "version": 453,
      "versionNonce": 565027222,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791886004573,
      "link": null,
      "locked": false,
      "text": "1. User should be able to upload videos\n2. User should be able to watch videos\n3. User can subscribe channels\n4. User can search for a video\n5. User can like/dislike a video\n6. User can comment on a video\n7. It should have ABS (Adaptive Bitrate Streaming)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. User should be able to upload videos\n2. User should be able to watch videos\n3. User can subscribe channels\n4. User can search for a video\n5. User can like/dislike a video\n6. User can comment on a video\n7. It should have ABS (Adaptive Bitrate Streaming)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qgakPKg31nHvJtcKQpGJW",
      "type": "text",
      "x": 136.85761741763451,
      "y": 331.7425139792837,
      "width": 277.73968505859375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
