      "isDeleted": false,
      "boundElements": null,
      "updated": 1791886004573,
      "link": null,
      "locked": false,
      "text": "Non-Functional Requirements",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional Requirements",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cESk-i3UhuvDpqRqmRspT",
      "type": "text",
      "x": 138.49477835137287,
      "y": 377.6272787233504,
      "width": 477.616943359375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 1699690186,
      "version": 313,
      "versionNonce": 207008790,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791886004573,
      "link": null,
      "locked": false,
      "text": "1. Availablity > Consistency\n2. Weak consistency (Like, Comment, Views)\n3. Strong consistency (Ownership, Permissions, Upload state)\n4. Low latency in video streaming\n5. Handling viral videos",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Availablity > Consistency\n2. Weak consistency (Like, Comment, Views)\n3. Strong consistency (Ownership, Permissions, Upload state)\n4. Low latency in video streaming\n5. Handling viral videos",
      "autoResize": true,
      "lineHeight": 1.25
    },
