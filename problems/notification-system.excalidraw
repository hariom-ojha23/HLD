      "seed": 1812879509,
      "version": 415,
      "versionNonce": 1145079253,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791367945617,
      "link": null,
      "locked": false,
      "text": "1. Support multiple types (SMS, Push, Email, In-app)\n2. Support priority (Transactional, Promotional, Information, OTP)\n3. Support template based notifications\n4. Support user preferences\n5. Retry failed delivery (At-least one delivery)\n6. Track delivery status",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Support multiple types (SMS, Push, Email, In-app)\n2. Support priority (Transactional, Promotional, Information, OTP)\n3. Support template based notifications\n4. Support user preferences\n5. Retry failed delivery (At-least one delivery)\n6. Track delivery status",
      "autoResize": true,
      "lineHeight": 1.25
    },
