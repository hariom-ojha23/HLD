    {
      "id": "GreP6vb1QhwdkZEIxDKb_",
      "type": "text",
      "x": 354,
      "y": 301,
      "width": 655.1593017578125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
