      "link": null,
      "locked": false,
      "text": "P = Partition\nA = Availability\nC = Consistency\nE = Else\nL = Latency\nC = Consistency",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P = Partition\nA = Availability\nC = Consistency\nE = Else\nL = Latency\nC = Consistency",
      "autoResize": true,
      "lineHeight": 1.25
