    {
      "id": "wS6I9Ex387LYcb63yoZ52",
      "type": "text",
      "x": -2537.6875,
      "y": 270,
      "width": 760.71923828125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1896622461,
      "version": 225,
      "versionNonce": 1941486973,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792328608332,
      "link": null,
      "locked": false,
      "text": "It describes what happens to a distributed system when one service cannot \ncommunicate with other service/s.\n\nIt this situation, the system must choose between consistency or Availability",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It describes what happens to a distributed system when one service cannot \ncommunicate with other service/s.\n\nIt this situation, the system must choose between consistency or Availability",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "P8UjGmkjmSv8p-ryOk43R",
      "type": "text",
      "x": -2537.6875,
      "y": 437,
      "width": 152.55984497070312,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1417595923,
      "version": 87,
      "versionNonce": 1842559165,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792328652179,
      "link": null,
      "locked": false,
      "text": "CAP stands for",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CAP stands for",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ioQK2XpH-8zjbuvpTj83n",
      "type": "text",
      "x": -2533.6875,
      "y": 492.8125,
      "width": 777.979248046875,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1195209939,
      "version": 509,
      "versionNonce": 797318781,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792328913879,
      "link": null,
      "locked": false,
      "text": "C = Consistency: Every read gets the latest successful write or an error\n     All nodes should agree on current value\n\nA = Availability: Every request receives the response, even if data is stale\n     Temporary difference is acceptable\n\nP = Partition: System continues operating even when nodes cannot communicate\n     Network partition is unavoidable in distributed system\n\n     Node A                X             Node B",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C = Consistency: Every read gets the latest successful write or an error\n     All nodes should agree on current value\n\nA = Availability: Every request receives the response, even if data is stale\n     Temporary difference is acceptable\n\nP = Partition: System continues operating even when nodes cannot communicate\n     Network partition is unavoidable in distributed system\n\n     Node A                X             Node B",
      "autoResize": true,
      "lineHeight": 1.25
    },
